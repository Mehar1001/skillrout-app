{
  "expo": {
    "name": "Skillrout",
    "slug": "skillrout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/skillrout-icon.png",
    "scheme": "skillrout",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "jsc",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/skillrout-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.skillrout"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/skillrout-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Skillrout to choose receipt and machine-reading photos for OCR and visit evidence.",
          "cameraPermission": "Allow Skillrout to photograph receipts and machine readings for OCR and visit evidence.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/skillrout-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "694b9e9a-3b14-454d-b3cf-2bbff9e40444"
      }
    }
  }
}
