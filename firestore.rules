rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function employee() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }

    function isOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    function isActiveEmployee(ownerId) {
      return signedIn()
             && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
             && employee().ownerId == ownerId
             && employee().active == true;
    }

    function isAssignedStore(ownerId, storeId) {
      return isActiveEmployee(ownerId) && storeId in employee().assignedStoreIds;
    }

    match /owners/{ownerId} {
      allow read, write: if isOwner(ownerId);

      match /stores/{storeId} {
        allow read: if isOwner(ownerId) || isAssignedStore(ownerId, storeId);
        allow write: if isOwner(ownerId);

        match /machines/{machineId} {
          allow read: if isOwner(ownerId) || isAssignedStore(ownerId, storeId);
          allow write: if isOwner(ownerId);
        }
      }

      match /visits/{visitId} {
        allow read: if isOwner(ownerId) || isActiveEmployee(ownerId);
        allow create: if isOwner(ownerId)
                      || (isAssignedStore(ownerId, request.resource.data.storeId)
                          && request.resource.data.employeeId == request.auth.uid
                          && request.resource.data.settlementStatus == 'not_submitted'
                          && request.resource.data.printStatus == 'not_printed');
        allow update: if isOwner(ownerId)
                      || (isActiveEmployee(ownerId)
                          && resource.data.employeeId == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['printStatus', 'printedAt', 'printedBy'])
                          && request.resource.data.printStatus == 'printed'
                          && request.resource.data.printedBy == request.auth.uid);
      }

      match /{document=**} {
        allow read, write: if isOwner(ownerId);
      }
    }

    match /employees/{employeeId} {
      allow read: if signedIn()
                  && (request.auth.uid == employeeId || request.auth.uid == resource.data.ownerId);
      allow update: if signedIn() && request.auth.uid == resource.data.ownerId;
    }
  }
}
